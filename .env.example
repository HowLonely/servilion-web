# URL del backend Django.
#
# DJANGO_API_URL la usa el servidor de Next (los route handlers de
# /api/auth/login y /api/auth/refresh, que guardan el refresh token en una
# cookie httpOnly). NEXT_PUBLIC_API_URL la usa el navegador: el cliente
# openapi-fetch le pega directo a Django, y por eso el backend debe listar este
# origen en CORS_ALLOWED_ORIGINS.
#
# Sin /api al final: las rutas generadas desde openapi.json ya lo traen
# (/api/clients/, /api/orders/...).
DJANGO_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
